---
layout: base.njk
cle: devis
permalink: /devis/
---
{%- set p = c.devis -%}
<section class="section devis">
  <div class="wrap wrap--etroit">
    <div class="devis__entete centre">
      <h1 class="titre-xl">{{ p.titre | inline | safe }}</h1>
      <div class="hero__intro hero__intro--centre">{{ p.texte | paras | safe }}</div>
    </div>

    <form class="form" id="form-devis" action="https://formspree.io/f/mjgjwnzp" method="POST" novalidate>
      <input type="text" name="_gotcha" class="cache" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="ligne2">
        <div class="champ"><label for="f-nom">{{ p.nom.label }}</label><input id="f-nom" type="text" name="name" autocomplete="name" placeholder="{{ p.nom.exemple }}" required></div>
        <div class="champ"><label for="f-email">{{ p.email.label }}</label><input id="f-email" type="email" name="email" autocomplete="email" placeholder="{{ p.email.exemple }}" required></div>
        <div class="champ">
          <label for="f-evenement">{{ p.evenement.label }}</label>
          <select id="f-evenement" name="event_type" required>
            <option value="" disabled selected>{{ p.evenement.choisir }}</option>
            {%- for o in p.evenement.options %}<option>{{ o }}</option>{% endfor %}
          </select>
        </div>
        <div class="champ"><label for="f-date">{{ p.date.label }}</label><input id="f-date" type="date" name="date"></div>
      </div>
      <div class="champ"><label for="f-participants">{{ p.participants.label }}</label><input id="f-participants" type="number" name="participants" min="1" placeholder="{{ p.participants.exemple }}"></div>
      <div class="champ"><label for="f-message">{{ p.message.label }}</label><textarea id="f-message" name="message" rows="5" placeholder="{{ p.message.exemple }}"></textarea></div>
      <p class="form__erreur" role="alert" hidden>{{ p.erreur }}</p>
      <div><button class="btn btn--l" type="submit">{{ p.bouton }} <svg class="ic ic--sm"><use href="#i-fleche"/></svg></button></div>
    </form>

    <div class="merci" id="merci" hidden tabindex="-1">
      <svg class="ic ic--xl"><use href="#i-coeur"/></svg>
      <h2 class="titre-l">{{ p.merci.titre }}</h2>
      <div class="prose">{{ p.merci.texte | paras | safe }}</div>
      <a class="btn" href="{{ c.general.footer.lien_instagram }}" target="_blank" rel="noopener">{{ p.merci.bouton }} <svg class="ic ic--sm"><use href="#i-fleche"/></svg></a>
    </div>
  </div>
</section>
