---
layout: base.njk
cle: realisations
permalink: /realisations/
---
{%- set p = c.realisations -%}
{%- set filtres = ["Lancements produit", "Événements de marque", "Collaborateurs"] -%}
<section class="hero hero--simple">
  <div class="wrap centre">
    <p class="surtitre surtitre--centre">{{ p.hero.surtitre }}</p>
    <h1 class="titre-xl">{{ p.hero.titre | inline | safe }}</h1>
    <div class="hero__intro hero__intro--centre">{{ p.hero.texte | paras | safe }}</div>
  </div>
</section>

<section class="section section--serree" data-filtrable>
  <div class="wrap">
    <div class="filtres" role="group" aria-label="Filtrer les réalisations">
      <button type="button" class="filtre" data-filtre="" aria-pressed="true">{{ p.filtre_tout }}</button>
      {%- for f in filtres %}
      <button type="button" class="filtre" data-filtre="{{ f | cle }}" aria-pressed="false">{{ f }}</button>
      {%- endfor %}
    </div>

    <div class="cartes cartes--3">
      {%- for r in p.projets %}
      <article class="carte" id="{{ r.client | cle }}" data-cat="{{ r.categorie | cle }}">
        <a class="carte__media" href="/realisations/{{ r.client | cle }}/" tabindex="-1" aria-hidden="true">{% photo r.photo, r.client + ", " + r.type, "", "(min-width: 900px) 33vw, 100vw" %}</a>
        <div class="carte__entete">
          {%- if r.logo %}{% photo r.logo, r.client, "carte__logo", "120px", false, [240] %}{% endif %}
          <h2 class="carte__client">{{ r.client }}</h2>
        </div>
        <p class="carte__type">{{ r.type }}</p>
        <div class="carte__resume">{{ r.description | paras | safe }}</div>
        <a class="lien" href="/realisations/{{ r.client | cle }}/">{{ p.bouton_projet }} <svg class="ic ic--sm"><use href="#i-fleche"/></svg></a>
      </article>
      {%- endfor %}
    </div>

    <h2 class="titre-m autres-titre">{{ p.autres.titre }}</h2>
    {%- set vignettes = p.autres.liste %}{% set prefixe = "autre" %}
    {% include "vignettes.njk" %}

    {%- if p.lien_prives and p.lien_prives.texte %}
    <p class="lien-discret"><a href="{{ p.lien_prives.lien }}">{{ p.lien_prives.texte }} <svg class="ic ic--sm"><use href="#i-fleche"/></svg></a></p>
    {%- endif %}
  </div>
</section>

{%- set cta = p.cta %}{% set devisParams = "" %}
{% include "cta.njk" %}
